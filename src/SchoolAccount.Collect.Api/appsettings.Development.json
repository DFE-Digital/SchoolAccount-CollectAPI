{
  "AzureAppConfiguration": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "SchoolAccount.Collect.Infrastructure.Census": "Debug"
      }
    },
    "WriteTo": {
      "Seq": {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:8081"
        }
      }
    }
  },
  "Telemetry": {
    "Destination": "Otlp"
  },
  "Census": {
    "UseDatabase": true,
    "ConnectionString": "Server=localhost,1433;User ID=sa;Password=MyStrongPassword123!;TrustServerCertificate=True;Connection Timeout=30;"
  }
}
